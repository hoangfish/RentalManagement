PORT=3000

# Comma-separated list of origins allowed to call the API (the web client)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Long random string. MUST be identical in SOCKET_SERVER/.env
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=a59c7afbb00667785773c5e5292604d0ce6c3c29a4102f626c376cf75656478a49cee2cca34aeb57c8006a6dc917cee2
JWT_EXPIRES_IN=7d

# Firebase service-account key file (Firebase console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OpenStreetMap services (address lookup + "what is nearby") ask apps to identify themselves:
# put your email (or website) here.
NOMINATIM_CONTACT=you@example.com

# Address lookups are biased towards Ho Chi Minh City. Uncomment to change or disable:
# GEOCODE_BIAS=off
# GEOCODE_VIEWBOX=106.36,11.16,107.03,10.35
