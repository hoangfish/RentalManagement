PORT=3000

# Comma-separated list of origins allowed to call the API (the web client)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Long random string. MUST be identical in SOCKET_SERVER/.env
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Firebase service-account key file (Firebase console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OpenStreetMap asks apps to identify themselves: put your email (or website) here.
# Used when turning a room's address into map coordinates.
NOMINATIM_CONTACT=you@example.com
